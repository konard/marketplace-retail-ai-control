<!doctype html>
<html lang="ru" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} — Контур управления</title>
  <link rel="stylesheet" href="/static/pico.min.css">
  <link rel="stylesheet" href="/static/app.css">
</head>
<body>
  <a class="skip-link" href="#main">Перейти к содержанию</a>
  <header class="container">
    <nav aria-label="Разделы">
      <ul><li><strong>Контур управления</strong></li></ul>
      <ul>
        <li><a href="/"{% if nav == "home" %} aria-current="page"{% endif %}>Отклонения</a></li>
        <li><a href="/team"{% if nav == "team" %} aria-current="page"{% endif %}>Команда</a></li>
        <li><a href="/scorecard"{% if nav == "scorecard" %} aria-current="page"{% endif %}>Итоги пилота</a></li>
      </ul>
    </nav>
  </header>
  <main id="main" class="container">
    {% block content %}{% endblock %}
  </main>
  <footer class="container">
    <small>{% if user is not none %}Вы вошли как пользователь {{ user }}. {% endif %}Данные: 1С, Wildberries, Ozon, сервис аналитики; задачи — в Битрикс24.</small>
  </footer>
</body>
</html>
