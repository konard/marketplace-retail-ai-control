{# The GOV.UK error summary: one alert at the top of the page that links to
   every field with an error. Errors without a field are plain text. #}
{% macro error_summary(errors, prefix="") %}
{% if errors %}
<div class="error-summary" role="alert" tabindex="-1">
  <p><strong>Исправьте ошибки</strong></p>
  <ul>
  {% for key, message in errors.items() %}
    <li>{% if key == "decision" %}{{ message }}{% else %}<a href="#{{ prefix }}{{ key }}">{{ message }}</a>{% endif %}</li>
  {% endfor %}
  </ul>
</div>
{% endif %}
{% endmacro %}
